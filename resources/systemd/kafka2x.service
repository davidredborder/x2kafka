[Unit]
Description=kafka2x egress service (Kafka consumer to HTTP/external endpoints)
After=network.target kafka.service

[Service]
Type=simple
User=root
RuntimeDirectory=kafka2x
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/kafka2x /etc/kafka2x/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
