[Unit]
Description=x2kafka multi-protocol conversion service (socket, fifo, syslog, http to kafka)
After=network.target kafka.service

[Service]
Type=simple
User=root
RuntimeDirectory=x2kafka
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/x2kafka /etc/x2kafka/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
