{
  "debug": false,
  "brokers": [
    "localhost:9092"
  ],
  "topic": "rb_events",
  "client_id": "x2kafka-daemon",
  "async": true,
  "batch_size": 500,
  "batch_timeout_ms": 10,
  "num_workers": 16,
  "channel_buffer_size": 50000,
  "socket_buffer_bytes": 8388608,
  "compression": "none",
  "allowed_ips": [],
  "blacklist_ips": [],
  "stats_port": 7979,
  "stats_bind": "127.0.0.1",
  "stats_socket": "/run/x2kafka/x2kafka.sock",
  "mib_dirs": [
    "/usr/share/snmp/mibs",
    "/var/lib/snmp/mibs",
    "/etc/redborder/mibs"
  ],
  "listeners": [
    {
      "name": "syslog-collector",
      "proto": "syslog",
      "bind": "0.0.0.0",
      "port": 514,
      "mode": "syslog",
      "topic": "rb_syslog",
      "kv_extract": true,
      "cef_extract": true,
      "schema_standardization": true,
      "regex_patterns": [
        "user=(?P<user>\\S+)",
        "Failed password for (invalid user )?(?P<user>\\S+) from (?P<src_ip>\\S+) port (?P<src_port>\\d+)"
      ],
      "enrichment_rules": [
        {
          "match_key": "src_ip",
          "match_value": "10.1.33.158",
          "topic": "rb_vault",
          "enrichment": {
            "sensor_name": "vaultD",
            "sensor_uuid": "e90902da-cec3-4020-9eaf-708ee32f86ac"
          }
        },
        {
          "match_fields": {
            "src_ip": "127.0.0.1",
            "app_name": "cep"
          },
          "contains": [
            "ALERT",
            "RULE"
          ],
          "topic": "rb_alerts",
          "enrichment": {
            "sensor_name": "CEP",
            "sensor_uuid": "f6eb42c9-7003-49f3-9a3b-4da6211d5c37"
          }
        }
      ]
    },
    {
      "name": "snmptrap-listener",
      "proto": "snmptrap",
      "bind": "0.0.0.0",
      "port": 162,
      "topic": "rb_trap",
      "allowed_ips": [
        "127.0.0.1",
        "10.0.0.0/8"
      ],
      "enrichment_rules": [
        {
          "match_key": "src_ip",
          "match_value": "127.0.0.1",
          "topic": "rb_trap",
          "enrichment": {
            "sensor_name": "trapD-local",
            "sensor_uuid": "e90902da-cec3-4020-9eaf-708ee32f86ac"
          }
        }
      ]
    },
    {
      "name": "http2k-listener",
      "proto": "http",
      "bind": "0.0.0.0",
      "port": 7980,
      "mode": "json",
      "enrichment_key": "sensor_uuid",
      "enrichment_map": {
        "bd2fe2c3-d0ff-4c27-aef9-122b698239b9": {
          "index_partitions": 5,
          "index_replicas": 1,
          "proxy_uuid": "bd2fe2c3-d0ff-4c27-aef9-122b698239b9",
          "sensor_uuid": "bd2fe2c3-d0ff-4c27-aef9-122b698239b9"
        }
      }
    },
    {
      "name": "local-unix-socket",
      "proto": "unix",
      "path": "/tmp/x2kafka_inbound.sock",
      "topic": "rb_socket_events",
      "mode": "line",
      "enrichment": {
        "source_type": "unix_stream"
      }
    },
    {
      "name": "snmptrap-fifo",
      "proto": "fifo",
      "path": "/tmp/snmptrap.fifo",
      "topic": "rb_snmp_traps",
      "mode": "json",
      "enrichment": {
        "source_type": "fifo_pipe"
      }
    }
  ]
}
